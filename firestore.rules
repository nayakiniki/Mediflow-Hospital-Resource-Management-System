rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    // User validation helper
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && data.role in ['clinician', 'physician', 'auditor']
        && (data.keys().hasAll(['uid', 'email', 'role']));
    }

    // Report validation helper
    function isValidReport(data, userId) {
      return data.userId == userId
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.filename is string && data.filename.size() <= 200
        && data.status in ['validated', 'requires_review', 'flagged']
        && data.report_summary is string && data.report_summary.size() <= 10000
        && (data.keys().hasAll(['id', 'userId', 'title', 'filename', 'status', 'report_summary']));
    }

    // --- Collections ---

    // Clinician User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department']);
      allow delete: if false;

      // Clinician Saved Reports & History Subcollection
      match /reports/{reportId} {
        allow get: if isOwner(userId) && isValidId(reportId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reportId) && isValidReport(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(reportId) && isValidReport(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'report_summary']);
        allow delete: if isOwner(userId) && isValidId(reportId);
      }
    }
  }
}
